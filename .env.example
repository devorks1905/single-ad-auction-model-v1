# =============================================
# TekReklam — Ortam Değişkenleri Şablonu
# =============================================
# Bu dosyayı .env.local olarak kaydet ve değerleri doldur.

# ─── ZORUNLU ───────────────────────────────────
# Supabase PostgreSQL bağlantı string'i
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Admin paneli şifresi (GÜÇLÜ BİR ŞİFRE SEÇ!)
ADMIN_PASSWORD=sifreni_buraya_yaz

# ─── OPsiyonel: Stripe Ödeme ───────────────────
# https://dashboard.stripe.com/apikeys adresinden al
# STRIPE_SECRET_KEY=sk_live_xxxxx

# ─── OPsiyonel: E-posta (Resend) ───────────────
# https://resend.com adresinden al (ücretsiz 100 email/gün)
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM=TekReklam <noreply@domain.com>

# ─── OPsiyonel: Cron Güvenlik ──────────────────
# Vercel Cron erişim anahtarı (karmaşık bir değer gir)
# CRON_SECRET=rastgele_uzun_bir_anahtar

# ─── OPsiyonel: Site URL ───────────────────────
# Alan adını bağladığında buraya yaz
# NEXT_PUBLIC_SITE_URL=https://tekreklam.com
